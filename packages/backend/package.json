{
  "name": "@pixegotchi/backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "npm run dev:watch",
    "dev:watch": "tsup src/server.ts --format esm --platform node --target node22 --sourcemap --clean --no-splitting --no-config --watch --onSuccess \"node --enable-source-maps dist/server.js\"",
    "build": "npm run prisma:generate && tsup src/server.ts --format esm --platform node --target node22 --sourcemap --clean --no-splitting --no-config",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "start": "node --enable-source-maps dist/server.js",
    "dev:docker": "npm run dev:watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "npm run prisma:migrate:deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:server": "BROWSER=none npx prisma studio --port 51212",
    "prisma:seed": "tsx src/database/seed.ts",
    "prisma:items": "tsx src/database/seed_items.ts",
    "test": "jest"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@pixegotchi/shared": "file:../shared",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@ton/crypto": "^3.2.0",
    "@ton/ton": "^13.11.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.7.2",
    "ioredis": "^5.3.2",
    "pg": "^8.17.2",
    "pino": "^8.19.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "node-pg-migrate": "^7.0.0",
    "prisma": "7.8.0",
    "tsup": "^8.4.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.2"
  }
}
