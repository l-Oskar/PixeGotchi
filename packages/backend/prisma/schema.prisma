// packages/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum PixegotchiStatus {
  active
  critical
  vault
  dead
}

enum PixegotchiGender {
  male
  female
}

enum ElementType {
  fire
  water
  earth
  air
  electric
  ice
  grass
  metal
  ghost
  poison
  psychic
  light
  dark
  rainbow
}

enum RarityType {
  common
  uncommon
  rare
  epic
  mythic
  legendary
}

enum ItemType {
  food
  medicine
  toy
  cleaning
  chest
  special
  boost
}

enum ChestType {
  wooden
  silver
  golden
  crystal
  mythic
  legendary
}

enum ListingType {
  egg
  pixegotchi
  chest
  item
  cosmetic
}

enum CurrencyType {
  pgc
  ton
  stars
}

enum MarketplaceListingStatus {
  active
  sold
  cancelled
  expired
}

enum MarketplaceTreasuryTransactionType {
  commission
  distribution
}

enum RoomCosmeticSlot {
  environment
  floor
  window
  curtain
  rug
  wallArt
  furniture
  sofa
  decor
}

// ============================================
// MODELS
// ============================================

model User {
  id                  Int     @id @default(autoincrement())
  telegramId          BigInt  @unique @map("telegram_id")
  walletAddress       String? @map("wallet_address") @db.VarChar(48)
  username            String? @db.VarChar(255)
  pgcBalance          Decimal @default(0) @map("pgc_balance") @db.Decimal(20, 8)
  currentPixegotchiId Int?    @unique @map("current_pixegotchi_id")

  // Додаткові поля
  lastActiveAt DateTime? @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  eggs                          Egg[]
  pixegotchis                   Pixegotchi[]                     @relation("UserPixegotchis")
  currentPixegotchi             Pixegotchi?                      @relation("CurrentPixegotchi", fields: [currentPixegotchiId], references: [id], onDelete: SetNull)
  inventory                     Inventory[]
  chests                        Chest[]
  vault                         Vault[]
  listings                      MarketplaceListing[]             @relation("SellerListings")
  marketplacePurchases          MarketplacePurchase[]            @relation("MarketplacePurchaseBuyer")
  marketplaceSales              MarketplacePurchase[]            @relation("MarketplacePurchaseSeller")
  treasuryAdminTransactions     MarketplaceTreasuryTransaction[] @relation("TreasuryTransactionAdmin")
  treasuryRecipientTransactions MarketplaceTreasuryTransaction[] @relation("TreasuryTransactionRecipient")
  cosmetics                     UserCosmetic[]
  roomLoadout                   UserRoomLoadout?

  @@index([telegramId])
  @@index([walletAddress])
  @@map("users")
}

// ============================================
// ROOM COSMETICS
// ============================================

model CosmeticAsset {
  id               String           @id @db.VarChar(64)
  name             String           @db.VarChar(100)
  slot             RoomCosmeticSlot
  rarity           RarityType       @default(common)
  assetUrl         String?          @map("asset_url") @db.VarChar(255)
  environmentId    String?          @map("environment_id") @db.VarChar(64)
  allowedPositions Int[]            @default([]) @map("allowed_positions")
  span             Int              @default(1)
  allowOverlap     Boolean          @default(false) @map("allow_overlap")
  isDefault        Boolean          @default(false) @map("is_default")
  isLimited        Boolean          @default(false) @map("is_limited")
  isTradable       Boolean          @default(true) @map("is_tradable")
  isPurchasable    Boolean          @default(false) @map("is_purchasable")
  pgcPrice         Decimal?         @map("pgc_price") @db.Decimal(20, 8)
  isChestReward    Boolean          @default(false) @map("is_chest_reward")
  chestDropWeight  Int              @default(0) @map("chest_drop_weight")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  environment         CosmeticAsset?          @relation("CosmeticEnvironmentCompatibility", fields: [environmentId], references: [id], onDelete: SetNull)
  compatibleAssets    CosmeticAsset[]         @relation("CosmeticEnvironmentCompatibility")
  ownerships          UserCosmetic[]
  placements          RoomCosmeticPlacement[]
  environmentLoadouts UserRoomLoadout[]       @relation("RoomLoadoutEnvironment")
  floorLoadouts       UserRoomLoadout[]       @relation("RoomLoadoutFloor")
  marketplaceListings MarketplaceListing[]

  @@index([slot, isActive])
  @@index([isPurchasable, isActive])
  @@index([isChestReward, isActive])
  @@index([rarity])
  @@index([environmentId])
  @@map("cosmetic_assets")
}

model UserCosmetic {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  cosmeticAssetId String   @map("cosmetic_asset_id") @db.VarChar(64)
  quantity        Int      @default(1)
  acquiredAt      DateTime @default(now()) @map("acquired_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset CosmeticAsset @relation(fields: [cosmeticAssetId], references: [id], onDelete: Restrict)

  @@unique([userId, cosmeticAssetId])
  @@index([userId])
  @@index([cosmeticAssetId])
  @@map("user_cosmetics")
}

model UserRoomLoadout {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique @map("user_id")
  environmentId String   @map("environment_id") @db.VarChar(64)
  floorId       String?  @map("floor_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment CosmeticAsset           @relation("RoomLoadoutEnvironment", fields: [environmentId], references: [id], onDelete: Restrict)
  floor       CosmeticAsset?          @relation("RoomLoadoutFloor", fields: [floorId], references: [id], onDelete: Restrict)
  placements  RoomCosmeticPlacement[]

  @@index([environmentId])
  @@index([floorId])
  @@map("user_room_loadouts")
}

model RoomCosmeticPlacement {
  id              Int      @id @default(autoincrement())
  loadoutId       Int      @map("loadout_id")
  cosmeticAssetId String   @map("cosmetic_asset_id") @db.VarChar(64)
  position        Int
  createdAt       DateTime @default(now()) @map("created_at")

  loadout UserRoomLoadout @relation(fields: [loadoutId], references: [id], onDelete: Cascade)
  asset   CosmeticAsset   @relation(fields: [cosmeticAssetId], references: [id], onDelete: Restrict)

  @@unique([loadoutId, cosmeticAssetId, position])
  @@index([loadoutId])
  @@index([cosmeticAssetId])
  @@map("room_cosmetic_placements")
}

// ============================================
// EGG - Окрема таблиця для яєць
// ============================================

model Egg {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  // Для відстеження на marketplace
  isListed       Boolean   @default(false) @map("is_listed")
  isHatching     Boolean   @default(false) @map("is_hatching")
  isHatched      Boolean   @default(false) @map("is_hatched")
  hatchStartedAt DateTime? @map("hatch_started_at")
  hatchedAt      DateTime? @map("hatched_at")
  hatchingTimeMs Int       @default(86400000) @map("hatching_time_ms") // 24 години в мс
  tapCount       Int       @default(0) @map("tap_count")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixegotchi          Pixegotchi?
  marketplaceListings MarketplaceListing[]

  @@index([userId])
  @@index([isListed])
  @@index([isHatching])
  @@index([isHatched])
  @@map("eggs")
}

// ============================================
// PIXEGOTCHI - Тільки вилуплені пети
// ============================================

model Pixegotchi {
  id         Int     @id @default(autoincrement())
  userId     Int     @map("user_id")
  eggId      Int     @unique @map("egg_id")
  nftAddress String? @map("nft_address") @db.VarChar(48)
  isListed   Boolean @default(false) @map("is_listed")

  // Genome (seed + parsed data)
  genomeHash String           @map("genome_hash") @db.VarChar(100)
  element    ElementType
  rarity     RarityType
  gender     PixegotchiGender
  traits     String[]

  // Basic info
  name       String           @default("Unnamed") @db.VarChar(50)
  status     PixegotchiStatus @default(active)
  level      Int              @default(1)
  experience Int              @default(0)

  // Stats у ВІДСОТКАХ (0-100)
  health      Int @default(100)
  hunger      Int @default(70)
  energy      Int @default(100)
  happiness   Int @default(50)
  cleanliness Int @default(100)

  // Critical state tracking
  healthZeroAt  DateTime? @map("health_zero_at")
  criticalSince DateTime? @map("critical_since")

  // Action timestamps
  lastFedAt     DateTime? @map("last_fed_at")
  lastPlayedAt  DateTime? @map("last_played_at")
  lastSleptAt   DateTime? @map("last_slept_at")
  lastCleanedAt DateTime? @map("last_cleaned_at")
  lastHealedAt  DateTime? @map("last_healed_at")
  lastBoostedAt DateTime? @map("last_boosted_at")
  lastUpdateAt  DateTime  @default(now()) @map("last_update_at")

  hatchedAt DateTime @default(now()) @map("hatched_at")

  user                User                 @relation("UserPixegotchis", fields: [userId], references: [id], onDelete: Cascade)
  currentForUser      User?                @relation("CurrentPixegotchi")
  egg                 Egg?                 @relation(fields: [eggId], references: [id])
  vault               Vault[]
  gameSessions        GameSession[]
  activeEffects       ActiveEffect[]
  marketplaceListings MarketplaceListing[]

  @@index([userId])
  @@index([status])
  @@index([eggId])
  @@index([rarity])
  @@index([element])
  @@index([isListed, status, level])
  @@map("pixegotchis")
}

// ============================================
// ACTIVE EFFECTS - Тимчасові бафи/дебафи
// ============================================

model ActiveEffect {
  id           Int @id @default(autoincrement())
  pixegotchiId Int @map("pixegotchi_id")

  effectType String  @db.VarChar(50)
  value      Decimal @db.Decimal(10, 2)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  pixegotchi Pixegotchi @relation(fields: [pixegotchiId], references: [id], onDelete: Cascade)

  @@index([pixegotchiId])
  @@index([expiresAt])
  @@map("active_effects")
}

// ============================================
// INVENTORY & ITEMS
// ============================================

model Inventory {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  itemId    String     @map("item_id") @db.VarChar(50)
  itemType  ItemType   @map("item_type")
  rarity    RarityType @default(common)
  quantity  Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("inventory")
}

model Chest {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  chestType            ChestType @map("chest_type")
  isOpened             Boolean   @default(false) @map("is_opened")
  marketplaceListingId Int?      @map("marketplace_listing_id")

  rewards Json?

  createdAt DateTime  @default(now()) @map("created_at")
  openedAt  DateTime? @map("opened_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaceListing MarketplaceListing? @relation("MarketplaceEscrowChests", fields: [marketplaceListingId], references: [id], onDelete: SetNull)

  @@index([userId, isOpened])
  @@index([chestType])
  @@index([marketplaceListingId])
  @@map("chests")
}

model Item {
  id          Int        @id @default(autoincrement())
  itemId      String     @unique @map("item_id") @db.VarChar(50)
  name        String     @db.VarChar(100)
  description String?    @db.Text
  itemType    ItemType   @map("item_type")
  rarity      RarityType @default(common)

  effects Json

  cooldownMinutes Int? @map("cooldown_minutes")
  maxPerDay       Int? @map("max_per_day")
  minLevel        Int? @default(1) @map("min_level")

  iconUrl     String? @map("icon_url") @db.VarChar(255)
  isStackable Boolean @default(true) @map("is_stackable")
  isTradable  Boolean @default(false) @map("is_tradable")
  maxStack    Int?    @default(99) @map("max_stack")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usageHistory        ItemUsageHistory[]
  marketplaceListings MarketplaceListing[]

  @@index([itemType])
  @@index([rarity])
  @@index([isTradable, itemType])
  @@map("items")
}

model ItemUsageHistory {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  pixegotchiId Int      @map("pixegotchi_id")
  itemId       String   @map("item_id") @db.VarChar(50)
  quantity     Int      @default(1)
  usedAt       DateTime @default(now()) @map("used_at")

  item Item @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@index([userId, pixegotchiId])
  @@index([itemId])
  @@index([usedAt])
  @@map("item_usage_history")
}

// ============================================
// VAULT
// ============================================

model Vault {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  pixegotchiId Int      @map("pixegotchi_id")
  finalLevel   Int      @map("final_level")
  storedAt     DateTime @default(now()) @map("stored_at")

  // Relations
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixegotchi Pixegotchi @relation(fields: [pixegotchiId], references: [id], onDelete: Cascade)

  @@unique([userId, pixegotchiId])
  @@index([userId])
  @@map("vault")
}

// ============================================
// MARKETPLACE
// ============================================

model MarketplaceListing {
  id       Int @id @default(autoincrement())
  sellerId Int @map("seller_id")

  listingType ListingType @map("listing_type")

  // Для eggs
  eggId Int? @map("egg_id")

  // Для pixegotchi (тільки vault, lvl 100)
  pixegotchiId Int? @map("pixegotchi_id")

  // Для items
  itemId            String?    @map("item_id") @db.VarChar(50)
  chestType         ChestType? @map("chest_type")
  cosmeticAssetId   String?    @map("cosmetic_asset_id") @db.VarChar(64)
  initialQuantity   Int        @default(1) @map("initial_quantity")
  remainingQuantity Int        @default(1) @map("remaining_quantity")

  unitPrice Decimal      @map("unit_price") @db.Decimal(20, 8)
  currency  CurrencyType @default(pgc)

  status    MarketplaceListingStatus @default(active)
  createdAt DateTime                 @default(now()) @map("created_at")
  expiresAt DateTime                 @map("expires_at")
  closedAt  DateTime?                @map("closed_at")

  // Relations
  seller        User                  @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  egg           Egg?                  @relation(fields: [eggId], references: [id], onDelete: Restrict)
  pixegotchi    Pixegotchi?           @relation(fields: [pixegotchiId], references: [id], onDelete: Restrict)
  item          Item?                 @relation(fields: [itemId], references: [itemId], onDelete: Restrict)
  cosmeticAsset CosmeticAsset?        @relation(fields: [cosmeticAssetId], references: [id], onDelete: Restrict)
  escrowChests  Chest[]               @relation("MarketplaceEscrowChests")
  purchases     MarketplacePurchase[]

  @@index([status, listingType])
  @@index([sellerId, status])
  @@index([status, expiresAt])
  @@index([eggId])
  @@index([pixegotchiId])
  @@index([itemId])
  @@index([chestType])
  @@index([cosmeticAssetId])
  @@map("marketplace_listings")
}

model MarketplacePurchase {
  id               Int          @id @default(autoincrement())
  listingId        Int          @map("listing_id")
  buyerId          Int          @map("buyer_id")
  sellerId         Int          @map("seller_id")
  quantity         Int
  unitPrice        Decimal      @map("unit_price") @db.Decimal(20, 8)
  subtotal         Decimal      @db.Decimal(20, 8)
  commissionBps    Int          @map("commission_bps")
  commissionAmount Decimal      @map("commission_amount") @db.Decimal(20, 8)
  sellerProceeds   Decimal      @map("seller_proceeds") @db.Decimal(20, 8)
  currency         CurrencyType @default(pgc)
  createdAt        DateTime     @default(now()) @map("created_at")

  listing             MarketplaceListing              @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer               User                            @relation("MarketplacePurchaseBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller              User                            @relation("MarketplacePurchaseSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  treasuryTransaction MarketplaceTreasuryTransaction?

  @@index([listingId])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@map("marketplace_purchases")
}

model MarketplaceTreasuryBalance {
  currency  CurrencyType @id
  balance   Decimal      @default(0) @db.Decimal(20, 8)
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("marketplace_treasury_balances")
}

model MarketplaceTreasuryTransaction {
  id              Int                                @id @default(autoincrement())
  transactionType MarketplaceTreasuryTransactionType @map("transaction_type")
  currency        CurrencyType                       @default(pgc)
  amount          Decimal                            @db.Decimal(20, 8)
  balanceAfter    Decimal                            @map("balance_after") @db.Decimal(20, 8)
  purchaseId      Int?                               @unique @map("purchase_id")
  adminUserId     Int?                               @map("admin_user_id")
  recipientUserId Int?                               @map("recipient_user_id")
  reason          String?                            @db.VarChar(200)
  createdAt       DateTime                           @default(now()) @map("created_at")

  purchase  MarketplacePurchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  admin     User?                @relation("TreasuryTransactionAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  recipient User?                @relation("TreasuryTransactionRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([currency, createdAt])
  @@index([recipientUserId, createdAt])
  @@map("marketplace_treasury_transactions")
}

// ============================================
// GAME SESSIONS
// ============================================

model GameSession {
  id           Int    @id @default(autoincrement())
  userId       Int    @map("user_id")
  pixegotchiId Int    @map("pixegotchi_id")
  gameId       String @map("game_id") @db.VarChar(50)

  score    Int @default(0)
  duration Int @default(0)

  pgcEarned        Decimal @default(0) @map("pgc_earned") @db.Decimal(20, 8) // ВИПРАВЛЕНО: tmcEarned → pgcEarned
  experienceGained Int     @default(0) @map("experience_gained")
  energySpent      Int     @default(0) @map("energy_spent")

  chestDropped Boolean @default(false) @map("chest_dropped")
  itemsDropped Json?   @map("items_dropped")

  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  pixegotchi Pixegotchi @relation(fields: [pixegotchiId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pixegotchiId])
  @@index([createdAt])
  @@map("game_sessions")
}

// ============================================
// QUESTS
// ============================================

model Quest {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(100)
  description String    @db.Text
  requirement String    @db.Text
  reward      String    @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  startDate   DateTime  @default(now()) @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  userQuests UserQuest[]

  @@map("quests")
}

model UserQuest {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  questId     Int       @map("quest_id")
  progress    Int       @default(0)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@map("user_quests")
}
