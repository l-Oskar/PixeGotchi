// packages/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum PixegotchiStatus {
  active
  critical  // health = 0, є 10-30 днів щоб врятувати
  vault
  dead
}

enum PixegotchiGender {
  male
  female
}

enum ElementType {
  fire
  water
  earth
  air
  electric
  ice
  grass
  metal
  ghost
  poison
  psychic
  light
  dark
  rainbow
}

enum RarityType {
  common
  uncommon
  rare
  epic
  mythic
  legendary
  unique
}

enum ItemType {
  food
  medicine
  toy
  cleaning
  chest
  special
  boost
}

enum ListingType {
  egg
  pixegotchi  // тільки vault (lvl 100)
  item
}

enum CurrencyType {
  pgc
  ton
}

// ============================================
// MODELS
// ============================================

model User {
  id            Int      @id @default(autoincrement())
  telegramId    BigInt   @unique @map("telegram_id")
  walletAddress String?  @map("wallet_address") @db.VarChar(48)
  username      String?  @db.VarChar(255)
  pgcBalance    Decimal  @default(0) @map("pgc_balance") @db.Decimal(20, 8)
  
  // Додаткові поля
  lastActiveAt  DateTime? @map("last_active_at")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  eggs         Egg[]
  pixegotchis  Pixegotchi[]
  inventory    Inventory[]
  chests       Chest[]
  vault        Vault[]
  listings     MarketplaceListing[] @relation("SellerListings")
  purchases    MarketplaceListing[] @relation("BuyerPurchases")

  @@index([telegramId])
  @@index([walletAddress])
  @@map("users")
}

// ============================================
// EGG - Окрема таблиця для яєць
// ============================================

model Egg {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  
  // Для відстеження на marketplace
  isListed        Boolean  @default(false) @map("is_listed")
  isHatching      Boolean  @default(false) @map("is_hatching")
  isHatched       Boolean  @default(false) @map("is_hatched")
  hatchStartedAt  DateTime? @map("hatch_started_at")
  hatchedAt       DateTime? @map("hatched_at") 
  hatchingTimeMs  Int       @default(86400000) @map("hatching_time_ms") // 24 години в мс
  tapCount        Int       @default(0) @map("tap_count")
  
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixegotchi      Pixegotchi?

  @@index([userId])
  @@index([isListed])
  @@index([isHatching])
  @@index([isHatched])
  @@map("eggs")
}

// ============================================
// PIXEGOTCHI - Тільки вилуплені пети
// ============================================

model Pixegotchi {
  id           Int               @id @default(autoincrement())
  userId       Int               @map("user_id")
  eggId        Int?              @unique @map("egg_id")
  nftAddress   String?           @map("nft_address") @db.VarChar(48)
  
  // Genome (seed + parsed data)
  genomeHash   String            @map("genome_hash") @db.VarChar(100)
  element      ElementType
  rarity       RarityType
  gender       PixegotchiGender
  traits       String[]          // ["lazy", "playful", "glutton"]
  
  // Basic info
  name         String            @default("Unnamed") @db.VarChar(50)
  status       PixegotchiStatus  @default(active)
  level        Int               @default(1)
  experience   Int               @default(0)

  // Stats у ВІДСОТКАХ (0-100)
  health       Int               @default(100)
  hunger       Int               @default(70)
  energy       Int               @default(100)
  happiness    Int               @default(50)
  cleanliness  Int               @default(100)

  // ВИДАЛЕНО: hungerRate, energyRate, etc. (розраховуються динамічно)
  
  // Critical state tracking
  healthZeroAt  DateTime?        @map("health_zero_at")
  criticalSince DateTime?        @map("critical_since")
  
  // Action timestamps
  lastFedAt     DateTime?        @map("last_fed_at")
  lastPlayedAt  DateTime?        @map("last_played_at")
  lastSleptAt   DateTime?        @map("last_slept_at")
  lastCleanedAt DateTime?        @map("last_cleaned_at")
  lastHealedAt  DateTime?        @map("last_healed_at")
  lastUpdateAt  DateTime         @default(now()) @map("last_update_at")
  
  hatchedAt    DateTime          @default(now()) @map("hatched_at")

  // Relations
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  egg          Egg?              @relation(fields: [eggId], references: [id])
  vault        Vault[]
  gameSessions GameSession[]
  activeEffects ActiveEffect[]

  @@index([userId])
  @@index([status])
  @@index([eggId])
  @@index([rarity])
  @@index([element])
  @@map("pixegotchis")
}

// ============================================
// ACTIVE EFFECTS - Тимчасові бафи/дебафи
// ============================================

model ActiveEffect {
  id           Int        @id @default(autoincrement())
  pixegotchiId Int        @map("pixegotchi_id")
  
  effectType   String     @db.VarChar(50)  // 'gold_boost', 'energy_regen', 'luck', etc.
  value        Decimal    @db.Decimal(10, 2)
  
  expiresAt    DateTime   @map("expires_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  
  // Relations
  pixegotchi   Pixegotchi @relation(fields: [pixegotchiId], references: [id], onDelete: Cascade)
  
  @@index([pixegotchiId])
  @@index([expiresAt])
  @@map("active_effects")
}

// ============================================
// INVENTORY & ITEMS
// ============================================

model Inventory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  itemId    String   @map("item_id") @db.VarChar(50)
  itemType  ItemType @map("item_type")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("inventory")
}

model Chest {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  chestHash  String   @map("chest_hash") @db.VarChar(100)
  chestType  String   @map("chest_type") @db.VarChar(20) // wooden, silver, golden, etc.
  rarity     RarityType
  isOpened   Boolean  @default(false) @map("is_opened")
  
  // Rewards (після відкриття)
  rewards    Json?    // ChestReward
  
  createdAt  DateTime @default(now()) @map("created_at")
  openedAt   DateTime? @map("opened_at")
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isOpened])
  @@map("chests")
}

model Item {
  id          Int      @id @default(autoincrement())
  itemId      String   @unique @map("item_id") @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  itemType    ItemType @map("item_type")
  rarity      RarityType @default(common)

  // Effects: { health: 50, hunger: 30, buffs: [...] }
  effects     Json

  cooldownMinutes Int? @map("cooldown_minutes")
  maxPerDay       Int? @map("max_per_day")
  minLevel        Int? @default(1) @map("min_level")

  iconUrl     String?  @map("icon_url") @db.VarChar(255)
  isStackable Boolean  @default(true) @map("is_stackable")
  maxStack    Int?     @default(99) @map("max_stack")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  usageHistory ItemUsageHistory[]

  @@index([itemType])
  @@index([rarity])
  @@map("items")
}

model ItemUsageHistory {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  pixegotchiId Int      @map("pixegotchi_id")
  itemId       String   @map("item_id") @db.VarChar(50)
  quantity     Int      @default(1)
  usedAt       DateTime @default(now()) @map("used_at")

  item         Item     @relation(fields: [itemId], references: [itemId], onDelete: Cascade)

  @@index([userId, pixegotchiId])
  @@index([itemId])
  @@index([usedAt])
  @@map("item_usage_history")
}

// ============================================
// VAULT
// ============================================

model Vault {
  id            Int        @id @default(autoincrement())
  userId        Int        @map("user_id")
  pixegotchiId  Int        @map("pixegotchi_id")
  finalLevel    Int        @map("final_level")
  storedAt      DateTime   @default(now()) @map("stored_at")

  // Relations
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixegotchi    Pixegotchi @relation(fields: [pixegotchiId], references: [id], onDelete: Cascade)

  @@unique([userId, pixegotchiId])
  @@index([userId])
  @@map("vault")
}

// ============================================
// MARKETPLACE
// ============================================

model MarketplaceListing {
  id           Int          @id @default(autoincrement())
  sellerId     Int          @map("seller_id")
  buyerId      Int?         @map("buyer_id")
  
  listingType  ListingType  @map("listing_type")
  
  // Для eggs
  eggId        Int?         @map("egg_id")
  
  // Для pixegotchi (тільки vault, lvl 100)
  pixegotchiId Int?         @map("pixegotchi_id")
  
  // Для items
  itemId       String?      @map("item_id") @db.VarChar(50)
  quantity     Int          @default(1)
  
  price        Decimal      @db.Decimal(20, 8)
  currency     CurrencyType @default(pgc)
  
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  soldAt       DateTime?    @map("sold_at")

  // Relations
  seller       User         @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer        User?        @relation("BuyerPurchases", fields: [buyerId], references: [id])

  @@index([isActive, listingType])
  @@index([sellerId])
  @@index([eggId])
  @@index([pixegotchiId])
  @@map("marketplace_listings")
}

// ============================================
// GAME SESSIONS
// ============================================

model GameSession {
  id               Int        @id @default(autoincrement())
  userId           Int        @map("user_id")
  pixegotchiId     Int        @map("pixegotchi_id")
  gameId           String     @map("game_id") @db.VarChar(50)
  
  score            Int        @default(0)
  duration         Int        @default(0) // seconds
  
  pgcEarned        Decimal    @default(0) @map("pgc_earned") @db.Decimal(20, 8)  // ВИПРАВЛЕНО: tmcEarned → pgcEarned
  experienceGained Int        @default(0) @map("experience_gained")
  energySpent      Int        @default(0) @map("energy_spent")
  
  chestDropped     Boolean    @default(false) @map("chest_dropped")
  itemsDropped     Json?      @map("items_dropped")  // [{ itemId: "apple", quantity: 1 }]
  
  completed        Boolean    @default(false)
  createdAt        DateTime   @default(now()) @map("created_at")
  completedAt      DateTime?  @map("completed_at")

  // Relations
  pixegotchi       Pixegotchi @relation(fields: [pixegotchiId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pixegotchiId])
  @@index([createdAt])
  @@map("game_sessions")
}

// ============================================
// QUESTS
// ============================================

model Quest {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(100)
  description String   @db.Text
  requirement String   @db.Text // JSON string with requirements
  reward      String   @db.Text // JSON string with rewards
  isActive    Boolean  @default(true) @map("is_active")
  startDate   DateTime @default(now()) @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  userQuests  UserQuest[]

  @@map("quests")
}

model UserQuest {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  questId     Int      @map("quest_id")
  progress    Int      @default(0)
  isCompleted Boolean  @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  quest       Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@map("user_quests")
}