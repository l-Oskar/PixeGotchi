{
  "name": "@pixegotchi/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --platform neutral",
    "build:dev": "tsup src/index.ts --format esm --sourcemap --clean --platform neutral",
    "dev": "tsup src/index.ts --format esm --sourcemap --watch --platform neutral",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.9.2"
  }
}
